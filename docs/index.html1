<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Customer Shopping Behavior — Live Dashboard</title>
<script src="https://cdn.plot.ly/plotly-3.7.0.min.js" charset="utf-8"></script>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;600;700;800&display=swap');
  :root{
    --navy:#0B2545; --teal:#13A89E; --gold:#E8A33D; --grey:#8D99AE;
    --red:#D64550; --bg:#F5F7FA; --card:#FFFFFF; --border:#E3E8EF; --text:#1B2430;
  }
  *{box-sizing:border-box;}
  body{
    margin:0; font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
    background:var(--bg); color:var(--text);
  }
  header{
    background:linear-gradient(135deg,var(--navy) 0%,#123A66 100%); color:#fff;
    padding:28px 32px 24px; position:relative;
  }
  header h1{margin:0 0 6px; font-size:1.6rem; font-weight:700;}
  header p{margin:0; opacity:.85; font-size:.95rem;}
  .lang-toggle{ position:absolute; top:28px; right:32px; display:flex; background:rgba(255,255,255,.12); border:1px solid rgba(255,255,255,.25); border-radius:8px; padding:3px; }
  .lang-toggle button{ border:none; background:transparent; color:#fff; padding:6px 14px; border-radius:6px; font-size:.8rem; font-weight:700; cursor:pointer; font-family:inherit; opacity:.7; }
  .lang-toggle button.active{ background:rgba(255,255,255,.25); opacity:1; }
  html[dir="rtl"] .lang-toggle{ right:auto; left:32px; }
  html[dir="rtl"] body{ font-family:'Tajawal',-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif; }
  html[dir="rtl"] .filter-actions{ margin-left:0; margin-right:auto; }
  html[dir="rtl"] .kpi-card .value{ direction:ltr; text-align:right; }
  html[dir="rtl"] [id^="chart-"]{ direction:ltr; }
  @media (max-width:900px){ .lang-toggle{ position:static; margin-bottom:12px; display:inline-flex; } }
  .wrap{max-width:1300px; margin:0 auto; padding:24px 20px 60px;}

  .filters{
    display:flex; flex-wrap:wrap; gap:12px; align-items:flex-end;
    background:var(--card); border:1px solid var(--border); border-radius:12px;
    padding:16px 18px; margin:-30px auto 22px; max-width:1260px; box-shadow:0 4px 18px rgba(11,37,69,.08);
  }
  .filter-field{display:flex; flex-direction:column; gap:4px;}
  .filter-field label{font-size:.72rem; text-transform:uppercase; letter-spacing:.04em; color:var(--grey); font-weight:600;}
  .filter-field select{
    padding:7px 10px; border-radius:8px; border:1px solid var(--border); background:#fff;
    font-size:.87rem; min-width:150px; color:var(--text);
  }
  .filter-actions{margin-left:auto; display:flex; align-items:center; gap:14px;}
  #reset-btn{
    background:var(--navy); color:#fff; border:none; padding:9px 16px; border-radius:8px;
    font-size:.85rem; cursor:pointer; font-weight:600;
  }
  #reset-btn:hover{background:#123A66;}
  #record-count{font-size:.82rem; color:var(--grey);}
  #record-count b{color:var(--navy);}

  .kpi-row{display:grid; grid-template-columns:repeat(4,1fr); gap:16px; margin-bottom:22px;}
  .kpi-card{
    background:var(--card); border:1px solid var(--border); border-radius:12px; padding:18px 20px;
    box-shadow:0 2px 8px rgba(11,37,69,.05);
  }
  .kpi-card .label{font-size:.78rem; color:var(--grey); font-weight:600; text-transform:uppercase; letter-spacing:.03em;}
  .kpi-card .value{font-size:1.7rem; font-weight:700; color:var(--navy); margin-top:6px;}

  .chart-grid{display:grid; grid-template-columns:repeat(2,1fr); gap:18px; margin-bottom:26px;}
  .chart-card{
    background:var(--card); border:1px solid var(--border); border-radius:12px; padding:14px 16px 6px;
    box-shadow:0 2px 8px rgba(11,37,69,.05);
  }
  .chart-card h3{margin:2px 4px 0; font-size:.95rem; color:var(--navy);}
  .chart-card .sub{margin:0 4px 6px; font-size:.76rem; color:var(--grey);}

  .insights{
    background:var(--card); border:1px solid var(--border); border-radius:12px; padding:22px 24px; margin-top:8px;
    box-shadow:0 2px 8px rgba(11,37,69,.05);
  }
  .insights h2{margin:0 0 14px; font-size:1.15rem; color:var(--navy);}
  .insight-item{padding:12px 0; border-top:1px solid var(--border);}
  .insight-item:first-of-type{border-top:none;}
  .insight-item .tag{
    display:inline-block; background:var(--teal); color:#fff; font-size:.68rem; font-weight:700;
    padding:2px 8px; border-radius:20px; margin-bottom:6px; letter-spacing:.03em;
  }
  .insight-item p{margin:0; font-size:.88rem; line-height:1.55; color:var(--text);}
  .insight-item b{color:var(--navy);}

  footer{text-align:center; padding:22px; font-size:.78rem; color:var(--grey);}
  footer a{color:var(--teal); text-decoration:none;}

  @media (max-width:900px){
    .kpi-row{grid-template-columns:repeat(2,1fr);}
    .chart-grid{grid-template-columns:1fr;}
    .filters{margin-top:-16px;}
    .filter-actions{margin-left:0; width:100%; justify-content:space-between;}
  }
</style>
</head>
<body>

<header>
  <div class="lang-toggle">
    <button id="btn-en" class="active" onclick="setLang('en')">English</button>
    <button id="btn-ar" onclick="setLang('ar')">العربية</button>
  </div>
  <h1 data-i18n="h1">📊 Customer Shopping Behavior — Live Dashboard</h1>
  <p data-i18n="hsub">3,900 retail transactions · filter by any dimension below — every chart and KPI recalculates live</p>
</header>

<div class="wrap">

  <div class="filters">
    <div class="filter-field">
      <label for="f-gender" data-i18n="lgender">Gender</label>
      <select id="f-gender"></select>
    </div>
    <div class="filter-field">
      <label for="f-sub" data-i18n="lsub">Subscription</label>
      <select id="f-sub"></select>
    </div>
    <div class="filter-field">
      <label for="f-cat" data-i18n="lcat">Category</label>
      <select id="f-cat"></select>
    </div>
    <div class="filter-field">
      <label for="f-season" data-i18n="lseason">Season</label>
      <select id="f-season"></select>
    </div>
    <div class="filter-field">
      <label for="f-ship" data-i18n="lship">Shipping Type</label>
      <select id="f-ship"></select>
    </div>
    <div class="filter-actions">
      <span id="record-count"></span>
      <button id="reset-btn" data-i18n="resetbtn">Reset filters</button>
    </div>
  </div>

  <div class="kpi-row">
    <div class="kpi-card"><div class="label" data-i18n="kpi1">Total Revenue</div><div class="value" id="kpi-revenue">—</div></div>
    <div class="kpi-card"><div class="label" data-i18n="kpi2">Orders</div><div class="value" id="kpi-orders">—</div></div>
    <div class="kpi-card"><div class="label" data-i18n="kpi3">Avg Order Value</div><div class="value" id="kpi-aov">—</div></div>
    <div class="kpi-card"><div class="label" data-i18n="kpi4">Avg Review Rating</div><div class="value" id="kpi-rating">—</div></div>
  </div>

  <div class="chart-grid">
    <div class="chart-card">
      <h3 data-i18n="c1t">Revenue by Category</h3>
      <div class="sub" data-i18n="c1s">Where the money actually comes from</div>
      <div id="chart-category" style="height:300px;"></div>
    </div>
    <div class="chart-card">
      <h3 data-i18n="c2t">Avg Order Value by Segment</h3>
      <div class="sub" data-i18n="c2s">Subscriber vs. non-subscriber, gender, shipping speed — dashed line = overall average</div>
      <div id="chart-aov" style="height:300px;"></div>
    </div>
    <div class="chart-card">
      <h3 data-i18n="c3t">Customer Segments</h3>
      <div class="sub" data-i18n="c3s">By previous purchase count — New (1) / Returning (2–10) / Loyal (10+)</div>
      <div id="chart-segment" style="height:300px;"></div>
    </div>
    <div class="chart-card">
      <h3 data-i18n="c4t">Top 10 Products by Avg Rating</h3>
      <div class="sub" data-i18n="c4s">Hover for order count behind each average</div>
      <div id="chart-rating" style="height:300px;"></div>
    </div>
    <div class="chart-card">
      <h3 data-i18n="c5t">Revenue by Season</h3>
      <div class="sub" data-i18n="c5s">Seasonality effect on total spend</div>
      <div id="chart-season" style="height:300px;"></div>
    </div>
    <div class="chart-card">
      <h3 data-i18n="c6t">Payment Method Mix</h3>
      <div class="sub" data-i18n="c6s">Share of orders by payment type</div>
      <div id="chart-payment" style="height:300px;"></div>
    </div>
  </div>

  <div class="insights">
    <h2 data-i18n="insightsh">💡 What the data says</h2>
    <div class="insight-item">
      <span class="tag" data-i18n="tag1">CATEGORY MIX</span>
      <p data-i18n="p1"><b>Clothing + Accessories drive 77% of revenue.</b> Footwear and Outerwear combined are the remaining 23% — merchandising and ad spend should concentrate accordingly.</p>
    </div>
    <div class="insight-item">
      <span class="tag" data-i18n="tag2">SUBSCRIPTION</span>
      <p data-i18n="p2"><b>Subscribers don't spend more per order.</b> $59.49 vs. $59.87 for non-subscribers — statistically flat. Data quirk worth flagging: 100% of subscribers in this dataset are male (0 female subscribers), so this is really "subscriber vs. non-subscriber <i>men</i>" — still no lift, and one more reason to redesign the perk rather than just promote it harder.</p>
    </div>
    <div class="insight-item">
      <span class="tag" data-i18n="tag3">GENDER</span>
      <p data-i18n="p3"><b>The gender revenue gap is a mix effect, not a behavior effect.</b> Male customers generate 68% of revenue simply because 68% of customers are male — average order value is nearly identical ($59.54 vs. $60.25).</p>
    </div>
    <div class="insight-item">
      <span class="tag" data-i18n="tag4">DISCOUNTS</span>
      <p data-i18n="p4"><b>839 customers use discounts and still spend 34% above average.</b> That's a distinct high-value segment hiding inside the "discount shopper" label — worth a dedicated offer.</p>
    </div>
    <div class="insight-item">
      <span class="tag" data-i18n="tag5">SEGMENTATION</span>
      <p data-i18n="p5"><b>80% of customers already qualify as "Loyal"</b> under the current previous-purchases rule — too generous to be useful for targeting without re-cutting the thresholds.</p>
    </div>
  </div>

</div>

<footer data-i18n="foot">
  Built with Python (pandas) · SQL · Power BI · Plotly.js &nbsp;|&nbsp; All figures computed live from the underlying dataset
</footer>

<script>
const DATA = {"gender":["Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","Male","M