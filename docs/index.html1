function uniqueSorted(col, fixedOrder){
  const vals = Array.from(new Set(DATA[col]));
  if (fixedOrder) return fixedOrder.filter(v => vals.includes(v));
  return vals.sort();
}

function populateSelect(id, values, allLabel, trMap){
  const el = document.getElementById(id);
  const prevValue = el.value || 'All';
  el.innerHTML = '';
  const optAll = document.createElement('option');
  optAll.value = 'All'; optAll.textContent = allLabel || 'All';
  el.appendChild(optAll);
  values.forEach(v=>{
    const o = document.createElement('option');
    o.value = v; o.textContent = trMap ? tr(trMap, v) : v;
    el.appendChild(o);
  });
  el.value = prevValue;
}

function filteredIndices(){
  const n = DATA.gender.length;
  const idx = [];
  for (let i=0;i<n;i++){
    if (state.gender!=='All' && DATA.gender[i]!==state.gender) continue;
    if (state.subscription_status!=='All' && DATA.subscription_status[i]!==state.subscription_status) continue;
    if (state.category!=='All' && DATA.category[i]!==state.category) continue;
    if (state.season!=='All' && DATA.season[i]!==state.season) continue;
    if (state.shipping_type!=='All' && DATA.shipping_type[i]!==state.shipping_type) continue;
    idx.push(i);
  }
  return idx;
}

function sum(a){ return a.reduce((x,y)=>x+y,0); }
function mean(a){ return a.length ? sum(a)/a.length : 0; }

function groupMean(catCol, valCol, idx, allowedKeys){
  const sums=new Map(), counts=new Map();
  for(const i of idx){
    const k = DATA[catCol][i];
    if (allowedKeys && !allowedKeys.includes(k)) continue;
    sums.set(k,(sums.get(k)||0)+DATA[valCol][i]);
    counts.set(k,(counts.get(k)||0)+1);
  }
  const out=new Map();
  for(const [k,v] of sums) out.set(k, {mean:v/counts.get(k), n:counts.get(k)});
  return out;
}

function groupSum(catCol, valCol, idx){
  const m=new Map();
  for(const i of idx){
    const k=DATA[catCol][i];
    m.set(k,(m.get(k)||0)+DATA[valCol][i]);
  }
  return m;
}

function groupCount(catCol, idx){
  const m=new Map();
  for(const i of idx){
    const k=DATA[catCol][i];
    m.set(k,(m.get(k)||0)+1);
  }
  return m;
}

function fmtUSD(v){ return '$' + Math.round(v).toLocaleString('en-US'); }
function fmtUSD2(v){ return '$' + v.toLocaleString('en-US', {minimumFractionDigits:2, maximumFractionDigits:2}); }
function fmtNum(v){ return v.toLocaleString('en-US'); }

const baseLayout = {
  margin:{t:10,l:50,r:16,b:40},
  font:{family:'-apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif', size:11, color:'#1B2430'},
  paper_bgcolor:'rgba(0,0,0,0)',
  plot_bgcolor:'rgba(0,0,0,0)',
  showlegend:false
};

function renderKPIs(idx){
  const rev = sum(idx.map(i=>DATA.purchase_amount[i]));
  const n = idx.length;
  const aov = n ? rev/n : 0;
  const rating = mean(idx.map(i=>DATA.review_rating[i]));
  document.getElementById('kpi-revenue').textContent = n ? fmtUSD(rev) : '—';
  document.getElementById('kpi-orders').textContent = fmtNum(n);
  document.getElementById('kpi-aov').textContent = n ? fmtUSD2(aov) : '—';
  document.getElementById('kpi-rating').textContent = n ? rating.toFixed(2)+' / 5' : '—';
  document.getElementById('record-count').innerHTML = 'Showing <b>' + fmtNum(n) + '</b> of ' + fmtNum(DATA.gender.length) + ' transactions';
}

function renderCategoryChart(idx){
  const g = groupSum('category','purchase_amount',idx);
  const cats = CATEGORY_ORDER.filter(c=>g.has(c));
  const vals = cats.map(c=>g.get(c));
  const labels = cats.map(c=>tr(AR_MAP.category,c));
  Plotly.react('chart-category', [{
    type:'bar', x:labels, y:vals,
    marker:{color:[PALETTE.navy,PALETTE.teal,PALETTE.gold,PALETTE.grey]},
    text:vals.map(v=>fmtUSD(v)), textposition:'outside',
    hovertemplate:'%{x}<br>%{text}<extra></extra>'
  }], {...baseLayout, yaxis:{title:I18N[currentLang].yRevenue}});
}

function renderAOVChart(idx){
  const predicates = [
    i=>DATA.subscription_status[i]==='Yes',
    i=>DATA.subscription_status[i]==='No',
    i=>DATA.gender[i]==='Male',
    i=>DATA.gender[i]==='Female',
    i=>DATA.shipping_type[i]==='Express',
    i=>DATA.shipping_type[i]==='Standard',
  ];
  const labelSet = I18N[currentLang].xAOV;
  const labels=[], vals=[], colors=[];
  predicates.forEach((pred, k)=>{
    const sub = idx.filter(pred);
    labels.push(labelSet[k]);
    vals.push(sub.length ? mean(sub.map(i=>DATA.purchase_amount[i])) : 0);
    colors.push(k%2===0 ? PALETTE.teal : PALETTE.grey);
  });
  const overall = idx.length ? mean(idx.map(i=>DATA.purchase_amount[i])) : 0;
  Plotly.react('chart-aov', [
    {type:'bar', x:labels, y:vals, marker:{color:colors},
     text:vals.map(v=>'$'+v.toFixed(0)), textposition:'outside',
     hovertemplate:'%{x}<br>$%{y:.2f}<extra></extra>'}
  ], {...baseLayout, yaxis:{title:I18N[currentLang].yAOV},
      shapes:[{type:'line', x0:-0.5, x1:5.5, y0:overall, y1:overall, line:{color:PALETTE.red, dash:'dash', width:1.5}}]
  });
}

function renderSegmentChart(idx){
  const g = groupCount('segment', idx);
  const segs = SEGMENT_ORDER.filter(s=>g.has(s));
  const vals = segs.map(s=>g.get(s));
  const labels = segs.map(s=>tr(AR_MAP.segment,s));
  const total = idx.length || 1;
  const custWord = currentLang==='ar' ? 'عميل' : 'customers';
  Plotly.react('chart-segment', [{
    type:'bar', orientation:'h', y:labels, x:vals,
    marker:{color:[PALETTE.navy,PALETTE.teal,PALETTE.gold]},
    text:vals.map(v=>fmtNum(v)+'  ('+(v/total*100).toFixed(0)+'%)'), textposition:'outside',
    hovertemplate:'%{y}<br>%{x} '+custWord+'<extra></extra>'
  }], {...baseLayout, xaxis:{title:I18N[currentLang].xCustomers}, margin:{...baseLayout.margin, l: currentLang==='ar' ? 60 : 80}});
}

function renderRatingChart(idx){
  const g = groupMean('item_purchased','review_rating',idx);
  const arr = Array.from(g.entries()).sort((a,b)=>b[1].mean-a[1].mean).slice(0,10).reverse();
  const ordersWord = currentLang==='ar' ? 'طلب' : 'orders';
  Plotly.react('chart-rating', [{
    type:'bar', orientation:'h', y:arr.map(a=>tr(AR_MAP.item,a[0])), x:arr.map(a=>a[1].mean),
    marker:{color:PALETTE.gold},
    text:arr.map(a=>a[1].mean.toFixed(2)), textposition:'outside',
    customdata:arr.map(a=>a[1].n),
    hovertemplate:'%{y}: %{x:.2f}/5<br>n=%{customdata} '+ordersWord+'<extra></extra>'
  }], {...baseLayout, xaxis:{title:I18N[currentLang].xRating, range:[0,5]}, margin:{...baseLayout.margin, l: currentLang==='ar' ? 110 : 90}});
}

function renderSeasonChart(idx){
  const g = groupSum('season','purchase_amount',idx);
  const seasons = SEASON_ORDER.filter(s=>g.has(s));
  const vals = seasons.map(s=>g.get(s));
  const labels = seasons.map(s=>tr(AR_MAP.season,s));
  Plotly.react('chart-season', [{
    type:'bar', x:labels, y:vals,
    marker:{color:PALETTE.teal},
    text:vals.map(v=>fmtUSD(v)), textposition:'outside',
    hovertemplate:'%{x}<br>%{text}<extra></extra>'
  }], {...baseLayout, yaxis:{title:I18N[currentLang].yRevenue}});
}

function renderPaymentChart(idx){
  const g = groupCount('payment_method', idx);
  const entries = Array.from(g.entries()).sort((a,b)=>b[1]-a[1]);
  const ordersWord = currentLang==='ar' ? 'طلب' : 'orders';
  Plotly.react('chart-payment', [{
    type:'pie', labels:entries.map(e=>tr(AR_MAP.payment,e[0])), values:entries.map(e=>e[1]), hole:.5,
    marker:{colors:[PALETTE.navy,PALETTE.teal,PALETTE.gold,PALETTE.grey,PALETTE.red,'#4C6EF5']},
    textinfo:'label+percent', textfont:{size:10}, hovertemplate:'%{label}<br>%{value} '+ordersWord+'<extra></extra>'
  }], {...baseLayout, margin:{t:10,l:10,r:10,b:10}});
}

function renderAll(){
  const idx = filteredIndices();
  renderKPIs(idx);
  renderCategoryChart(idx);
  renderAOVChart(idx);
  renderSegmentChart(idx);
  renderRatingChart(idx);
  renderSeasonChart(idx);
  renderPaymentChart(idx);
}

function refreshSelects(){
  const t = I18N[currentLang];
  populateSelect('f-gender', uniqueSorted('gender'), t.allG, AR_MAP.gender);
  populateSelect('f-sub', ['Yes','No'], t.allC, AR_MAP.yesno);
  populateSelect('f-cat', uniqueSorted('category', CATEGORY_ORDER), t.allCat, AR_MAP.category);
  populateSelect('f-season', uniqueSorted('season', SEASON_ORDER), t.allS, AR_MAP.season);
  populateSelect('f-ship', uniqueSorted('shipping_type'), t.allShip, AR_MAP.shipping);
}

function applyStaticText(){
  const t = I18N[currentLang];
  document.querySelectorAll('[data-i18n]').forEach(el=>{
    const key = el.getAttribute('data-i18n');
    if (t[key] !== undefined) el.innerHTML = t[key];
  });
}

function setLang(lang){
  currentLang = lang;
  document.documentElement.lang = lang;
  document.documentElement.dir = lang === 'ar' ? 'rtl' : 'ltr';
  document.getElementById('btn-en').classList.toggle('active', lang==='en');
  document.getElementById('btn-ar').classList.toggle('active', lang==='ar');
  applyStaticText();
  refreshSelects();
  renderAll();
}

function init(){
  refreshSelects();

  document.getElementById('f-gender').addEventListener('change', e=>{state.gender=e.target.value; renderAll();});
  document.getElementById('f-sub').addEventListener('change', e=>{state.subscription_status=e.target.value; renderAll();});
  document.getElementById('f-cat').addEventListener('change', e=>{state.category=e.target.value; renderAll();});
  document.getElementById('f-season').addEventListener('change', e=>{state.season=e.target.value; renderAll();});
  document.getElementById('f-ship').addEventListener('change', e=>{state.shipping_type=e.target.value; renderAll();});
  document.getElementById('reset-btn').addEventListener('click', ()=>{
    state.gender='All'; state.subscription_status='All'; state.category='All'; state.season='All'; state.shipping_type='All';
    document.getElementById('f-gender').value='All';
    document.getElementById('f-sub').value='All';
    document.getElementById('f-cat').value='All';
    document.getElementById('f-season').value='All';
    document.getElementById('f-ship').value='All';
    renderAll();
  });

  renderAll();
}

init();
</script>
</body>
</html>
